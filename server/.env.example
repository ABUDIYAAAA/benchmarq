# Server Configuration
PORT=8000
ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
# Matches docker-compose.yaml configuration
DATABASE_URL=postgres://user:password@localhost:5433/bechmarqdb?sslmode=disable

# Authentication & Security
JWT_SECRET=benchmarq_super_secret_jwt_key_change_in_prod_12345
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=benchmarq
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

# Deep Linking & Desktop App
DESKTOP_LAUNCH_URL=benchmarq://launch
SNAPSHOT_DIR=storage/snapshots

# Password Reset & Verification
RESET_PASSWORD_EXPIRY_MINUTES=15
EMAIL_VERIFICATION_EXPIRY_HOURS=24
ORG_INVITE_EXPIRY_DAYS=7

# SMTP & Mailer (e.g. Mailhog or local SMTP on 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@benchmarq.io
SMTP_FROM_NAME=Benchmarq
SMTP_ENCRYPTION=none
EMAIL_WORKERS=5
EMAIL_QUEUE_SIZE=100

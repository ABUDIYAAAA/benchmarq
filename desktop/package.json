{
  "name": "benchmarq-desktop",
  "productName": "Benchmarq Exam",
  "version": "0.1.0",
  "description": "Secure exam client for Benchmarq",
  "main": "src/main/index.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "BENCHMARQ_APP_URL=http://localhost:3000 BENCHMARQ_API_URL=http://localhost:8000/api/v1 electron .",
    "launch:dev": "electron . \"benchmarq://launch?code=$CODE\"",
    "lint": "node --check src/main/*.js src/main/integrity/*.js src/preload/*.js src/capture/*.js",
    "test": "node --test test/*.test.js",
    "dist": "node scripts/write-app-config.js && electron-builder",
    "dist:mac": "node scripts/write-app-config.js && electron-builder --mac",
    "dist:win": "node scripts/write-app-config.js && electron-builder --win",
    "dist:mac:dev": "BENCHMARQ_APP_URL=http://localhost:3000 BENCHMARQ_API_URL=http://localhost:8000/api/v1 node scripts/write-app-config.js && electron-builder --mac dmg --arm64 -c.mac.identity=- -c.mac.hardenedRuntime=false"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.benchmarq.exam",
    "productName": "Benchmarq Exam",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Benchmarq Exam",
        "schemes": [
          "benchmarq"
        ]
      }
    ],
    "afterPack": "build/fuses.js",
    "mac": {
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Benchmarq Exam takes periodic camera snapshots to proctor the exam."
      }
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage"
    },
    "dmg": {
      "title": "Benchmarq Exam"
    }
  }
}

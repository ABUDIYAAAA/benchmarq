<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required by the V8 JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Proctoring snapshots use the camera. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- Deliberately absent: allow-dyld-environment-variables, disable-library-validation,
       get-task-allow. Without them code cannot be injected into the app. -->
</dict>
</plist>
